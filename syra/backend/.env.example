# Copy to .env — never commit real secrets.

# development | staging | production
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql://syra:syra@localhost:5432/syra
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0

# development: any string ok
# staging/production: openssl rand -hex 32 (min 32 chars, not a placeholder)
SECRET_KEY=change-me-in-production

REPOS_BASE_PATH=./repos

# Comma-separated or JSON array
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional: api.example.com,127.0.0.1 (enables TrustedHostMiddleware)
# TRUSTED_HOSTS=

# development: auto-create tables with SQLAlchemy (do not use in production)
DEV_AUTO_CREATE_SCHEMA=true

# If true, API runs `alembic upgrade head` on startup (alternative to Docker entrypoint)
RUN_MIGRATIONS_ON_STARTUP=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
