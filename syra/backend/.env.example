# Copy to .env — never commit real secrets.

# development | staging | production
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql://syra:syra@localhost:5432/syra
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0

# development: any string ok
# staging/production: openssl rand -hex 32 (min 32 chars, not a placeholder)
SECRET_KEY=change-me-in-production

REPOS_BASE_PATH=./repos

# Comma-separated or JSON array
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional: api.example.com,127.0.0.1 (enables TrustedHostMiddleware)
# TRUSTED_HOSTS=

# development: auto-create tables with SQLAlchemy (do not use in production)
DEV_AUTO_CREATE_SCHEMA=true

# If true, API runs `alembic upgrade head` on startup (alternative to Docker entrypoint)
RUN_MIGRATIONS_ON_STARTUP=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Professor rubric weights (should sum to ~1.0)
GRADE_WEIGHT_QUALITY=0.30
GRADE_WEIGHT_EFFICIENCY=0.25
GRADE_WEIGHT_DOCUMENTATION=0.20
GRADE_WEIGHT_TESTING=0.15
GRADE_WEIGHT_CONSISTENCY=0.10

# Blend AI score into final grade (0=metrics only, 0.30 recommended, 1=AI only)
GRADE_AI_BLEND=0.30

# Run pytest during analysis when test files exist
RUN_PYTEST_ON_ANALYZE=true
PYTEST_TIMEOUT_SECONDS=20
